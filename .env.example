# Public hostname of the Fly app (no scheme).
# Prefer FEEDGEN_HOSTNAME — plain HOSTNAME collides with the OS/shell variable.
FEEDGEN_HOSTNAME=anarchist-bluesky-feed.fly.dev

# did:web for this feedgen service (defaults to did:web:$FEEDGEN_HOSTNAME)
SERVICE_DID=did:web:anarchist-bluesky-feed.fly.dev

# Feed record URI after publish_feed.py
FEED_URI=at://did:plc:REPLACE/app.bsky.feed.generator/anarchism

# Bluesky credentials for publish_feed.py only (use an app password)
HANDLE=chriscarrollsmith.bsky.social
PASSWORD=

RECORD_NAME=anarchism
DISPLAY_NAME=Prosocial Anarchism
DESCRIPTION=Celebrating mutual aid, dual power, and movements that decentralize political power and capital.
AVATAR_PATH=

# Runtime knobs
IGNORE_REPLY_POSTS=true
IGNORE_ARCHIVED_POSTS=true
POST_RETENTION_DAYS=7
# Soft author priors: unlock bare ambiguous terms after N strong matches
SOFT_PRIOR_MIN_STRONG=3
SOFT_PRIOR_WINDOW_DAYS=30
DATABASE_PATH=/data/feed_database.db
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
PORT=8080
LOG_LEVEL=INFO

# Feed ranking among indexed matches: indexed | created | engagement
RANKING_MODE=indexed
# Comma-separated substrings; matching posts are not indexed (empty = off)
MUTED_KEYWORDS=

# Second-pass values-alignment classifier (ambiguous leftovers only)
CLASSIFIER_ENABLED=true
CLASSIFIER_MODEL=deepseek-v4-flash
CLASSIFIER_THRESHOLD=0.72
CLASSIFIER_TIMEOUT_S=8
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
